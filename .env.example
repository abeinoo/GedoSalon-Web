# SQLite connection string used by both the Prisma CLI and the app at runtime.
# Local dev: file:./dev.db
# Production (Docker, see DEPLOY.md): file:/data/app.db
DATABASE_URL="file:./dev.db"

# Secret used to sign the admin session cookie (JWT). Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Used only by `npm run db:seed` to create the initial admin account.
# REQUIRED in production (NODE_ENV=production) — the seed script refuses to
# run without it rather than falling back to a default password. In local
# development, omitting it falls back to a documented dev-only password.
ADMIN_EMAIL=admin@gedosalons.com
ADMIN_PASSWORD=

# Public site URL, used to resolve absolute Open Graph/SEO image URLs and
# the sitemap/robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.gedosalons.com

# Set to "production" when deploying (enables the ADMIN_PASSWORD guard
# above and stricter cookie settings). Leave unset for local dev.
NODE_ENV=development
